# Supabase Configuration
# Required for Supabase Auth, PostgreSQL database, and Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-side Role Key (Optional / Server-only, do NOT expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Market Data Provider (To be configured when market data provider is finalized)
# MARKET_DATA_API_KEY=your-market-data-api-key
# MARKET_DATA_BASE_URL=https://api.marketdata.example.com

# Optional LLM Provider for Explanation Generation (Future phase only)
# GROQ_API_KEY=your-groq-api-key
